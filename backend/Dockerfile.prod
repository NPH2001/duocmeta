FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY backend/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt

COPY backend/ /app/
COPY infra/docker/backend/start-prod.sh /usr/local/bin/backend-start-prod
RUN chmod +x /usr/local/bin/backend-start-prod

EXPOSE 8000

CMD ["backend-start-prod"]
